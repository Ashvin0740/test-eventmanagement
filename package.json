{
    "name": "even-management-platform",
    "version": "1.0.0",
    "description": "Event Management Platform Backend",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc",
        "start": "node --env-file=.env dist/index.js",
        "dev": "tsx watch --clear-screen=false --env-file .env src/index.ts",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix"
    },
    "dependencies": {
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dayjs": "^1.11.19",
        "ejs": "^3.1.10",
        "express": "^4.18.2",
        "helmet": "^7.2.0",
        "ioredis": "^5.8.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.16.0",
        "morgan": "^1.10.0",
        "nodemailer": "^7.0.10",
        "socket.io": "^4.8.1",
        "undici": "^7.10.0"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "eslint": "^8.54.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
