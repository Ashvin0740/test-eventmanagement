<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Error</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                background-color: #f5f5f5;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 20px;
            }

            .container {
                background: white;
                border: 1px solid #ddd;
                max-width: 500px;
                width: 100%;
                padding: 40px;
                text-align: center;
            }

            .icon {
                font-size: 48px;
                color: #ffc107;
                margin-bottom: 20px;
            }

            h1 {
                color: #333;
                font-size: 24px;
                margin-bottom: 15px;
            }

            p {
                color: #666;
                font-size: 16px;
                line-height: 1.5;
                margin-bottom: 25px;
            }

            .error-details {
                background: #f8f9fa;
                border-left: 3px solid #ffc107;
                padding: 15px;
                margin-bottom: 25px;
                text-align: left;
            }

            .error-details p {
                margin: 0;
                font-size: 14px;
                color: #333;
                font-family: monospace;
            }

            .button-group {
                display: flex;
                gap: 10px;
                justify-content: center;
            }

            .button {
                display: inline-block;
                color: white;
                text-decoration: none;
                padding: 12px 24px;
                border: none;
                cursor: pointer;
            }

            .button-primary {
                background: #007bff;
            }

            .button-primary:hover {
                background: #0056b3;
            }

            .button-secondary {
                background: #6c757d;
            }

            .button-secondary:hover {
                background: #5a6268;
            }

            @media (max-width: 480px) {
                .button-group {
                    flex-direction: column;
                }

                .button {
                    width: 100%;
                }
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="icon">!</div>

            <h1>Something Went Wrong</h1>

            <p><%= message || 'We encountered an error while processing your request. Please try again.' %></p>

            <% if (errorMsg) { %>
            <div class="error-details">
                <p>Error: <%= errorMsg %></p>
            </div>
            <% } %>

            <div class="button-group">
                <button onclick="window.location.reload()" class="button button-primary">Try Again</button>
                <a href="/" class="button button-secondary">Go Home</a>
            </div>
        </div>
    </body>
</html>

